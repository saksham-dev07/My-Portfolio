{
  "name": "saksham-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0",
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun run build:world && vite",
    "dev:world": "bun run --cwd experiments/saksham-driving-world dev",
    "build:world": "bun scripts/build-world.mjs",
    "build": "bun run build:world && vite build",
    "test:world": "bun run --cwd experiments/saksham-driving-world test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "preview": "vite preview",
    "install:world": "bun install --cwd experiments/saksham-driving-world --frozen-lockfile",
    "audit:production": "bun scripts/audit-production.mjs",
    "assets:optimize": "bun scripts/assets/optimize-images.mjs && biome check src/assets/responsive/index.js --write",
    "assets:world": "bun scripts/assets/optimize-world-landmarks.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.0.8",
    "@react-three/fiber": "9.1.2",
    "lucide-react": "^0.511.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "resend": "^6.30.0",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "draco3d": "^1.5.7",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.1"
  }
}
