diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..b77508a7e8e6b50a1be103f8fc94c2974a7be6a7
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Inspect iteratively before any
+// recursive AST walker; options cannot raise these security bounds.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  let count = 0;
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128) throw new RangeError('brace AST nesting exceeds safety limit');
+    if (seen.has(node)) throw new RangeError('cyclic or shared brace AST');
+    seen.add(node);
+    if (++count > 65536) throw new RangeError('brace AST size exceeds safety limit');
+    if (Array.isArray(node.nodes)) {
+      if (pending.length + node.nodes.length > 65536) throw new RangeError('brace AST size exceeds safety limit');
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
